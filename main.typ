    columns: 2,
    gutter: 2em,
    [x: ((a b) c d)],
    [y: (e f)]
  ),
  caption: [Lists `x`: `((a b) c d)` and `y`: `(e f)`.],
) <fig-3-12>

#figure(
  rect(inset: 10pt)[Placeholder for Figure 3.13 (set-car! x y)],
